# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# LLM Configuration (OpenAI-compatible client: OpenAI, Groq, OpenRouter, Together, Ollama, etc.)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# For free/alternative providers, e.g.:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:11434/v1
LLM_INCLUDE_REASONING=false
LLM_REASONING_EFFORT=low

# Application Settings
DEMO_MODE=true
CHASER_INTERVAL_SECONDS=60
PORT=8000

# Security & Dev Endpoints
DEV_ADMIN_TOKEN=your_optional_dev_admin_secret_token
CHAT_RATE_LIMIT_PER_MINUTE=20
